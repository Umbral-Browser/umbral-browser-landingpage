---
import {languages, getCopy, type Locale} from '../i18n';
import {pagePath, type PageSlug} from '../content/navigation';
interface Props { lang: Locale; page?: PageSlug | '' }
const {lang, page = ''} = Astro.props;
const t = getCopy(lang);
---
<div class="locale-picker">
  <details class="locale-menu">
    <summary aria-label={t.language}>{languages.find(item => item.code === lang)?.label} ⌄</summary>
    <ul aria-label={t.language}>
      {languages.map(({code,label}) => <li><a href={pagePath(code,page)} lang={code} hreflang={code} aria-current={code === lang ? 'page' : undefined}>{label}</a></li>)}
    </ul>
  </details>
</div>
<style>
.locale-picker{position:relative;font-size:12px}.locale-menu{padding:0;border:0}.locale-menu summary{font-size:12px;padding:7px 10px;border:1px solid #49494b;border-radius:6px;list-style:none;background:#19191b;white-space:nowrap}.locale-menu summary::-webkit-details-marker{display:none}.locale-menu ul{position:absolute;z-index:30;top:100%;right:0;padding:7px;margin:5px 0;list-style:none;background:#202022;border:1px solid #444;border-radius:7px;min-width:115px;box-shadow:0 10px 25px #0006}.locale-menu a{display:block;padding:7px 10px;border-radius:4px}.locale-menu a:hover,.locale-menu a[aria-current=page]{background:#343033}
</style>
